{
  "title": "System Health",
  "version": 1,
  "panels": [
    {
      "title": "API Request Rate",
      "type": "graph",
      "targets": [
        {"expr": "rate(http_requests_total[5m])", "legendFormat": "Requests/s"}
      ]
    },
    {
      "title": "API Error Rate",
      "type": "graph",
      "targets": [
        {"expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m])", "legendFormat": "Error Rate"}
      ]
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "targets": [
        {"expr": "process_resident_memory_bytes", "legendFormat": "Memory"}
      ]
    },
    {
      "title": "Database Connections",
      "type": "graph",
      "targets": [
        {"expr": "pg_stat_activity_count", "legendFormat": "Active Connections"}
      ]
    }
  ]
}
